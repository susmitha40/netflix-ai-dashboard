		lineageTag: 88143dca-5da1-43e6-a050-c8fda4291516
		summarizeBy: sum
		sourceColumn: marketing_spend_usd_m

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column content_spend_usd_m
